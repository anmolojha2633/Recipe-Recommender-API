{
  "openapi": "3.0.1",
  "info": {
    "title": "RecipeRecommender.API",
    "version": "1.0"
  },
  "paths": {
    "/api/recipes/recommend": {
      "post": {
        "tags": [
          "Recipe"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeRequestDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeRequestDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeRequestDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RecipeRequestDTO": {
        "type": "object",
        "properties": {
          "ingredients": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "goal": {
            "type": "string",
            "nullable": true
